APP_ENV=development
DATABASE_URL=sqlite:///./data/autopassport.db
STORAGE_PATH=./data/storage
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=5242880
MAX_OWNER_ATTACHMENTS=100
MAX_OWNER_STORAGE_BYTES=262144000
PUBLIC_BASE_URL=http://127.0.0.1:8000
BACKUP_PATH=./data/backups
ADMIN_BACKUP_TOKEN=change-me

# Production requirements:
# APP_ENV=production
# PUBLIC_BASE_URL must use HTTPS
# COOKIE_SECURE=true
# ADMIN_BACKUP_TOKEN must contain at least 32 non-default characters
# DATABASE_URL must use an absolute SQLite path or an external database
# STORAGE_PATH and BACKUP_PATH must be different directories
# MAX_OWNER_STORAGE_BYTES must be at least MAX_UPLOAD_BYTES
